diff --git a/packages/media_core/lib/util/platform_utils.dart b/packages/media_core/lib/util/platform_utils.dart
index a1bf183..954f8e5 100644
--- a/packages/media_core/lib/util/platform_utils.dart
+++ b/packages/media_core/lib/util/platform_utils.dart
@@ -35,14 +35,30 @@ abstract final class PlatformUtils {
     return Platform.isFuchsia;
   }
 
+  /// Whether running on OpenHarmony/HarmonyOS.
+  ///
+  /// Uses [Platform.operatingSystem] instead of a hypothetical
+  ///  so the package still compiles on SDKs without the
+  /// oh-flutter extension.
+  static bool get isOhos {
+    return Platform.operatingSystem == 'ohos';
+  }
+
   /// Whether running on desktop.
+  ///
+  /// HarmonyOS stays out of the desktop family even in 2-in1 form: the
+  /// desktop windowing stack (window_manager/tray/acrylic) has no ohos
+  /// implementation, so desktop code paths must not select there.
   static bool get isDesktop {
     return isWindows || isMacOS || isLinux;
   }
 
   /// Whether running on mobile.
+  ///
+  /// ohos aligns with the mobile platform family: SystemChrome, immersive
+  /// fullscreen and the mobile presentation paths all work there.
   static bool get isMobile {
-    return isAndroid || isIOS;
+    return isAndroid || isIOS || isOhos;
   }
 
   /// Whether running on TV-like platform.
@@ -79,6 +95,10 @@ abstract final class PlatformUtils {
       return 'fuchsia';
     }
 
+    if (isOhos) {
+      return 'ohos';
+    }
+
     return 'unknown';
   }
 
@@ -122,6 +142,9 @@ abstract final class PlatformUtils {
       case 'fuchsia':
         return 'Fuchsia';
 
+      case 'ohos':
+        return 'HarmonyOS';
+
       default:
         return 'Unknown';
     }
diff --git a/packages/media_core_ui/lib/src/common/player_controls_style.dart b/packages/media_core_ui/lib/src/common/player_controls_style.dart
